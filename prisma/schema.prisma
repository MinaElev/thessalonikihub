// ThessalonikiHub database schema.
//
// Mirrors the domain model in src/lib/types.ts, plus the fields needed for
// user submissions: a moderation `status`, an `ownerId`, and a `Claim` flow.
// Per-locale text (name/summary/description/…) is stored as JSON ({ el, en, … })
// so new languages can be added without migrations.
//
// Target: Supabase Postgres. `directUrl` is the non-pooling connection used for
// migrations; `url` is the pooled connection used at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Pillar {
  STAY
  EAT
  DRINK
  DISCOVER
  EXPERIENCES
}

enum ListingStatus {
  DRAFT // being edited by the owner, not submitted
  PENDING // submitted, awaiting moderation
  PUBLISHED // approved and live
  REJECTED // rejected by a moderator
}

enum UserRole {
  USER // a visitor with an account
  OWNER // a business owner managing listings
  ADMIN // a moderator / site admin
}

enum Facet {
  AREA
  TYPE
  INTENT
}

enum GuideCategory {
  ITINERARY
  FOOD
  NIGHTLIFE
  AREAS
  SEASONAL
  TIPS
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user account. `id` mirrors the Supabase auth user id (uuid).
model Profile {
  id        String      @id
  email     String      @unique
  name      String?
  role      UserRole    @default(USER)
  createdAt DateTime    @default(now())
  places    Place[]     @relation("OwnerPlaces")
  events    EventItem[] @relation("OwnerEvents")
  claims    Claim[]
}

/// A place: accommodation, restaurant, bar, attraction or experience.
model Place {
  id          String  @id @default(cuid())
  slug        String  @unique
  kind        Pillar
  name        Json
  summary     Json
  description Json
  type        String
  tags        String[]

  // location
  lat     Float
  lng     Float
  area    String
  address Json?

  photos     Json // Photo[]
  contact    Json // ContactInfo
  amenities  String[] @default([])
  priceRange Int?
  offers     Json? // Offer[]
  faqs       Json? // Faq[]
  stay       Json? // StayDetails (accommodation-specific structured fields)
  service    Json? // ServiceDetails (services-specific structured fields)
  rating     Json? // Rating { average, count } — from moderated reviews
  verified   Boolean  @default(false)
  featured   Boolean  @default(false)

  // moderation / ownership
  status        ListingStatus @default(PENDING)
  owner         Profile?      @relation("OwnerPlaces", fields: [ownerId], references: [id])
  ownerId       String?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  claims    Claim[]

  @@index([kind, status])
  @@index([area])
  @@index([status])
}

/// A dated happening (concert, festival, exhibition …).
model EventItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        Json
  summary     Json
  description Json
  type        String
  tags        String[]
  startsAt    DateTime
  endsAt      DateTime?
  venue       Json
  lat         Float
  lng         Float
  area        String
  photos      Json
  contact     Json
  priceInfo   Json?
  featured    Boolean  @default(false)

  status        ListingStatus @default(PENDING)
  owner         Profile?      @relation("OwnerEvents", fields: [ownerId], references: [id])
  ownerId       String?
  rejectionNote String?

  // Provenance for imported events (iCal / Eventbrite / …).
  source     String?
  sourceUrl  String?
  externalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, status])
}

/// A curated, editor-created collection page (the SEO backbone).
model Collection {
  id              String  @id @default(cuid())
  slug            String
  pillar          Pillar
  facet           Facet
  match           String
  title           Json
  heading         Json
  intro           Json
  metaDescription Json
  featured        Boolean @default(false)

  @@unique([pillar, slug])
}

/// Long-form editorial content (guides, itineraries).
model Guide {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         Json
  excerpt       Json
  body          Json
  category      GuideCategory
  cover         Json
  author        String
  relatedPlaces String[]      @default([])
  featured      Boolean       @default(false)
  status        ListingStatus @default(PUBLISHED)
  publishedAt   DateTime
  updatedAt     DateTime      @updatedAt
}

/// A request by a user to claim ownership of an existing place.
model Claim {
  id        String      @id @default(cuid())
  place     Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId   String
  user      Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    ClaimStatus @default(PENDING)
  message   String?
  createdAt DateTime    @default(now())

  @@unique([placeId, userId])
}
