// ThessalonikiHub database schema.
//
// Mirrors the domain model in src/lib/types.ts, plus the fields needed for
// user submissions: a moderation `status`, an `ownerId`, and a `Claim` flow.
// Per-locale text (name/summary/description/…) is stored as JSON ({ el, en, … })
// so new languages can be added without migrations.
//
// Target: Supabase Postgres. `directUrl` is the non-pooling connection used for
// migrations; `url` is the pooled connection used at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Pillar {
  STAY
  EAT
  DRINK
  DISCOVER
  EXPERIENCES
  SERVICES
}

enum ListingStatus {
  DRAFT // being edited by the owner, not submitted
  PENDING // submitted, awaiting moderation
  PUBLISHED // approved and live
  REJECTED // rejected by a moderator
}

enum UserRole {
  USER // a visitor with an account
  OWNER // a business owner managing listings
  ADMIN // a moderator / site admin
}

enum Facet {
  AREA
  TYPE
  INTENT
}

enum GuideCategory {
  ITINERARY
  FOOD
  NIGHTLIFE
  AREAS
  SEASONAL
  TIPS
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user account. `id` mirrors the Supabase auth user id (uuid).
model Profile {
  id        String      @id
  email     String      @unique
  name      String?
  role      UserRole    @default(USER)
  createdAt DateTime    @default(now())
  places    Place[]     @relation("OwnerPlaces")
  events    EventItem[] @relation("OwnerEvents")
  claims    Claim[]
  saved     SavedItem[]
  /// Opaque token that makes the saved list readable at /list/<token>.
  /// Null until the owner turns sharing on; regenerating it revokes old links.
  shareToken String? @unique
}

/// A place: accommodation, restaurant, bar, attraction or experience.
model Place {
  id          String  @id @default(cuid())
  slug        String  @unique
  kind        Pillar
  name        Json
  summary     Json
  description Json
  type        String
  tags        String[]

  // location
  lat     Float
  lng     Float
  area    String
  address Json?

  photos     Json // Photo[]
  contact    Json // ContactInfo
  amenities  String[] @default([])
  priceRange Int?
  offers     Json? // Offer[]
  faqs       Json? // Faq[]
  stay       Json? // StayDetails (accommodation-specific structured fields)
  service    Json? // ServiceDetails (services-specific structured fields)
  rating     Json? // Rating { average, count } — from moderated reviews
  /// Opening hours per weekday, supplied by the owner. Never invented.
  hours      Json? // OpeningHours { mon..sun: "09:00-17:00" }
  /// Optional SEO overrides written by an editor; fall back to name/summary.
  seoTitle       Json?
  seoDescription Json?
  verified   Boolean  @default(false)
  featured   Boolean  @default(false)

  // moderation / ownership
  status        ListingStatus @default(PENDING)
  owner         Profile?      @relation("OwnerPlaces", fields: [ownerId], references: [id])
  ownerId       String?
  rejectionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, status])
  @@index([area])
  @@index([status])
}

/// A dated happening (concert, festival, exhibition …).
model EventItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        Json
  summary     Json
  description Json
  type        String
  tags        String[]
  startsAt    DateTime
  endsAt      DateTime?
  /// False when the source gave only a date; the time in startsAt is padding.
  timeKnown   Boolean  @default(true)
  venue       Json
  /// Null when the source named no venue we can place on a map.
  lat         Float?
  lng         Float?
  area        String?
  /// False while the text is still the source feed's wording (kept noindex).
  textRewritten Boolean @default(true)
  photos      Json
  contact     Json
  priceInfo   Json?
  featured    Boolean  @default(false)

  status        ListingStatus @default(PENDING)
  owner         Profile?      @relation("OwnerEvents", fields: [ownerId], references: [id])
  ownerId       String?
  rejectionNote String?

  // Provenance for imported events (iCal / Eventbrite / …).
  source     String?
  sourceUrl  String?
  externalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, status])
}

/// A curated, editor-created collection page (the SEO backbone).
model Collection {
  id              String  @id @default(cuid())
  slug            String
  pillar          Pillar
  facet           Facet
  match           String
  title           Json
  heading         Json
  intro           Json
  metaDescription Json
  featured        Boolean @default(false)

  @@unique([pillar, slug])
}

/// Long-form editorial content (guides, itineraries).
model Guide {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         Json
  excerpt       Json
  body          Json
  category      GuideCategory
  cover         Json
  author        String
  relatedPlaces String[]      @default([])
  featured      Boolean       @default(false)
  status        ListingStatus @default(PUBLISHED)
  publishedAt   DateTime
  updatedAt     DateTime      @updatedAt
}

/// A request by a user to claim ownership of an existing place.
model Claim {
  id        String      @id @default(cuid())
  /// Slug of the claimed listing. Keyed by slug rather than by a Place
  /// relation, because listings live in content files as well as in the
  /// database and the repository merges the two by slug.
  placeSlug String
  /// Pillar and display name captured when the claim is filed, so the review
  /// queue reads correctly even for a listing that has no database row yet.
  placeKind String
  placeName String
  user      Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  status    ClaimStatus @default(PENDING)
  message   String?
  createdAt DateTime    @default(now())

  @@unique([placeSlug, userId])
  @@index([status])
}

/// Something a signed-in user saved to their personal list.
model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What was saved: "place" | "event" | "route" | "dish" | "festival".
  kind      String
  /// Slug of the saved entity.
  slug      String
  /// In-app path (no locale prefix), so the list renders without lookups.
  path      String
  /// Label captured at save time, so the list survives content edits.
  label     String
  createdAt DateTime @default(now())

  @@unique([userId, kind, slug])
  @@index([userId])
}

/// Newsletter subscriber. Storing the address is separate from sending:
/// delivery requires an external email provider.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("el")
  /// Set once the address is verified via a confirmation email.
  confirmed      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([confirmed])
}

/// One day's view count for one listing.
///
/// Aggregated on write rather than stored per visit: there is no row per
/// visitor, no identifier, no IP and no cookie — only "this listing was opened
/// N times on this day". That keeps the promise the privacy page makes while
/// still giving an owner a reason to pay for placement.
model ListingView {
  id    String   @id @default(cuid())
  /// Pillar segment of the public URL: "stay", "eat", ..., or "events".
  kind  String
  slug  String
  /// Midnight Europe/Athens for the day being counted.
  day   DateTime @db.Date
  count Int      @default(0)

  @@unique([kind, slug, day])
  @@index([kind, slug])
  @@index([day])
}
