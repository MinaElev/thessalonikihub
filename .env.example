# ---- Site ----
# Canonical production origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://thessalonikihub.gr

# ---- Database (Supabase Postgres) ----
# From Supabase: Project Settings → Database → Connection string.
# DATABASE_URL uses the pooled connection (port 6543, pgbouncer);
# DIRECT_URL uses the direct connection (port 5432) for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Supabase Auth & Storage (needed for the next phase: login + submissions) ----
# From Supabase: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ---- Event import (optional) ----
# Protects the /api/cron/import-events endpoint. Send header:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET="<random-long-string>"
# Comma-separated iCal feeds, each optionally "label|url".
EVENT_ICAL_FEEDS="megaron|https://example.com/megaron.ics,ktbe|https://example.com/ktbe.ics"
# Comma-separated RSS feeds, each optionally "label|url".
# Confirmed working Thessaloniki source (verify permission before production):
EVENT_RSS_FEEDS="thessalonikiguide|https://www.thessalonikiguide.gr/event/feed/"
# Eventbrite (optional).
EVENTBRITE_TOKEN="<eventbrite-private-token>"
EVENTBRITE_ORG="<eventbrite-organization-id>"
